# Required: SQLAlchemy connection string for the target database
# MySQL:
DB_URL=mysql+pymysql://user:password@host:3306/database_name

# PostgreSQL (comment out MySQL and uncomment this):
# DB_URL=postgresql+psycopg2://user:password@host:5432/database_name

# Optional: Set to YES to export results to exports/<database_name>_schema_issues.csv
EXPORT_TO_CSV=YES
